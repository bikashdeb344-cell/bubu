{
  "name": "mmu-photo-portal-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "worker"
  ],
  "scripts": {
    "install:all": "npm install",
    "test:worker": "npm --prefix worker test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:worker && npm run test:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:worker": "npm --prefix worker run typecheck",
    "build": "npm run build:frontend && npm run build:worker"
  }
}
