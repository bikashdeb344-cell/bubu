# MMU Photo Upload Portal - Environment Variables

# ==========================================
# Google Drive API & OAuth 2.0 Configuration
# ==========================================
# OAuth 2.0 Client ID obtained from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth 2.0 Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# OAuth 2.0 Refresh Token with scope: https://www.googleapis.com/auth/drive or https://www.googleapis.com/auth/drive.file
GOOGLE_REFRESH_TOKEN=1//your-oauth-refresh-token

# Google Drive Root Storage Folder ID (the alphanumeric ID from the Google Drive URL of MMU-PHOTO-STORAGE)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J-example-folder-id

# ==========================================
# Backend / Worker Configuration
# ==========================================
# Allowed frontend origin for CORS restrictions (set to your frontend domain in production, or * for development)
ALLOWED_ORIGIN=*

# Upload Limits (defaults: 15 MB per image, 20 images max per upload submission)
MAX_FILE_SIZE_MB=15
MAX_FILES_PER_UPLOAD=20

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
# Base URL for Backend API (points to Cloudflare Worker endpoint, e.g., https://mmu-photo-portal-worker.<subdomain>.workers.dev or http://localhost:8787 during local dev)
VITE_API_BASE_URL=http://localhost:8787


